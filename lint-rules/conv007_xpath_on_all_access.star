# mxtk-lint-rule: conv007_xpath_on_all_access
# Shipped by mxcli-project-toolkit. This file REPLACES the same-named rule that
# `mxcli init` seeds into .claude/lint-rules/. Do not hand-edit: tune it through
# .claude/lint-config.yaml (below). `mxcli init` silently overwrites it, and
# sync-project.sh restores it only while the marker line above is present and unmodified.
# See skills/lint-that-actually-runs.md.
# --- end mxtk-lint-rule header ---
# CONV007: XPath on all access (WRITE; READ opt-in)
#
# An entity access rule that lets a role WRITE rows with no XPath constraint lets that role
# write every row of the entity. That is the access widening to catch: a seeded bug that
# dropped the "own DRAFT requisitions" scope from the Employee write rule was exactly one new
# CONV007 line (MTA E2, 2026-11-05).
#
# WHY THIS COPY EXISTS. The stock rule (mxcli 0.17.0 to 0.28.0, the same file in every version captured in STOCK-HASHES-BUNDLED.txt) flags every READ and every
# WRITE row without an XPath, for every role, with no option. On a 20-module procurement app
# that is 217 findings, 177 of them READ: staff roles reading master data, which is by design,
# and admin roles, which are unscoped by definition. The one line that mattered was 1 in 2,892.
# A rule that fires 217 times is baselined and never read again. Measured on that app: stock
# 217, this rule at its defaults 29 (the 29 WRITE rows of non-admin roles), and the seeded bug
# still shows as exactly one new finding.
#
# What changed against stock:
#   - WRITE rows only. READ without an XPath is opt-in (`check_read`). PII and anonymous
#     READ stay covered by SEC006 / SEC007 / SEC008.
#   - Admin roles are skipped (`skip_roles`, default Admin, Administrator): unscoped write is
#     the point of an admin role. The match is on the bare module-role name (the part after
#     the last dot), so Procurement.Admin and InvoiceMatching.Admin are both skipped.
#   - A module skip list (`skip_modules`), for vendor / Marketplace modules you cannot edit.
#     (lint-gate.sh already passes .claude/lint-vendor-modules.txt to `mxcli lint -e`; this is
#     for runs without it, and for modules you want in the gate but not in this rule.)
#   Message and severity are the stock ones, so a finding reads the same as before.
#
# Configure in .claude/lint-config.yaml (the ONLY way; do not edit this file):
#
#   rules:
#     CONV007:
#       options:
#         check_read: false                 # default false; true also flags unscoped READ
#         skip_roles: "Admin, Administrator"   # default; bare module-role names, one text
#         skip_modules: "GenAICommons, AgentCommons"   # default none; one text
#
# Lists are ONE comma-separated text (the toolkit pins mxcli 0.26 behaviour, where a YAML
# list reaches a rule as None). A YAML list on an mxcli that converts lists is accepted too.
#
# KNOWN LIMIT. This reads the access rule, not the runtime: the MTA E2 run found that a
# Create XPath was not applied to a created object in the test executor. A passing CONV007 is
# "no unscoped write is declared", not "rows are protected".
#
# SELF-CHECKS (a rule that cannot see must say so, never report a clean pass):
#   - check_read is not true / false, or skip_roles / skip_modules is neither text nor a list:
#     one `_rule` finding, and the rule does not silently fall back to the defaults.

RULE_ID = "CONV007"
RULE_NAME = "XPathOnAllAccess"
DESCRIPTION = "Entity WRITE access rules should have XPath constraints (READ opt-in via check_read; admin roles skipped)"
CATEGORY = "security"
SEVERITY = "info"

DEFAULT_SKIP_ROLES = "Admin, Administrator"


def _blind(msg, suggestion):
    return violation(
        message=msg,
        location=location(module="_rule", document_type="Entity", document_name="CONV007"),
        suggestion=suggestion,
    )


def _names(raw):
    # One comma-separated text, or a list of texts. Anything else is unusable (None).
    if type(raw) == "string":
        return [x.strip() for x in raw.split(",") if x.strip()]
    if type(raw) == "list":
        out = []
        for x in raw:
            if type(x) != "string":
                return None
            out.append(x.strip())
        return [x for x in out if x]
    return None


def check():
    check_read = get_option("check_read", False)
    if type(check_read) != "bool":
        return [_blind(
            "CONV007 option check_read is {} ({}), not true / false. This rule inspected NOTHING.".format(repr(check_read), type(check_read)),
            "Set `check_read: true` or `false` under `rules: CONV007: options:` in .claude/lint-config.yaml.",
        )]
    skip_roles = _names(get_option("skip_roles", DEFAULT_SKIP_ROLES))
    if skip_roles == None:
        return [_blind(
            "CONV007 option skip_roles is not a comma-separated text. This rule inspected NOTHING.",
            "Set `skip_roles: \"Admin, Administrator\"` (one text) under `rules: CONV007: options:` in .claude/lint-config.yaml.",
        )]
    skip_modules = _names(get_option("skip_modules", ""))
    if skip_modules == None:
        return [_blind(
            "CONV007 option skip_modules is not a comma-separated text. This rule inspected NOTHING.",
            "Set `skip_modules: \"ModuleA, ModuleB\"` (one text) under `rules: CONV007: options:` in .claude/lint-config.yaml.",
        )]

    violations = []
    for entity in entities():
        if entity.entity_type != "Persistent" or entity.is_external:
            continue
        if entity.module_name in skip_modules:
            continue
        for perm in permissions_for(entity.qualified_name):
            if perm.access_type != "WRITE" and not (check_read and perm.access_type == "READ"):
                continue
            if perm.is_constrained:
                continue
            if perm.module_role_name.split(".")[-1] in skip_roles:
                continue
            violations.append(violation(
                message="Entity '{}' has unconstrained {} access for role '{}' - all rows are accessible".format(
                    entity.qualified_name, perm.access_type, perm.module_role_name),
                location=location(module=entity.module_name, document_type="Entity", document_name=entity.qualified_name),
                suggestion="Add an XPath constraint to limit which rows '{}' can {} on '{}'".format(perm.module_role_name, perm.access_type.lower(), entity.name),
            ))
    return violations
