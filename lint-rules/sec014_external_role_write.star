# mxtk-lint-rule: sec014_external_role_write
# Shipped by mxcli-project-toolkit. Do not hand-edit: configure it through
# .claude/lint-config.yaml (below). sync-project.sh refreshes it while it is unedited and
# reports (never overwrites) a locally edited copy. See lint-rules/README.md.
# --- end mxtk-lint-rule header ---
# SEC014: External role can write state, audit or ownership members
#
# An external user role (a partner, customer or operator portal role, named per project)
# holds entity WRITE on: every member (`write *`); a workflow-state enumeration (`Status`,
# `State`, `Result`, `Stage`, `Phase`); an audit attribute (`...At` / `...By`); or an
# association the access rule's own XPath uses for ownership.
#
# Why: `grant create, read *, write * on X to Partner where [owner = CurrentUser]` passes
# every stock rule (CONV006 reports only create/delete, CONV007 only a missing XPath, the
# SEC00x rules app settings and PII reads). Yet it lets that role set its own record's
# Status through the client API, past the approval microflow that is supposed to be the
# only way to change it, and re-point the owner association. Field evidence (issue #268,
# mxcli 0.25.0): a partner role held `create, read *, write *` on two partner-owned
# entities with a state attribute; lint showed only CONV006 +4, re-baselined as "by
# design"; a manual security review found it five days later.
#
# Configure in .claude/lint-config.yaml (the ONLY way; do not edit this file):
#
#   rules:
#     SEC014:
#       options:
#         external_roles: "Partner, Customer"   # user role or module role names, comma-separated
#         # external_roles: "none"               # rule off: ONLY on the user's answer, asked in chat
#                                                # and recorded in PROJECT.md; never to silence a notice
#         # state_names: "Status, State, Result, Stage, Phase"   # the default list
#
# The value is ONE TEXT, not a YAML list: mxcli passes only bool / int / float / text
# options to Starlark, and a list reaches the rule as None (mxcli 0.26.0,
# goValueToStarlark). A list is reported, not ignored.
#
# A name matches a user role (all its module roles count) or a module role, qualified
# (`Portal.Partner`) or bare (`Partner`). One finding per entity x configured role,
# listing the members. Skipped: System / Administration, non-persistable and external
# entities.
#
# NOT CONFIGURED YET (option absent): the rule returns nothing, and bin/sync-project.sh
# prints a NOTE instead, on every sync (bin/lib/sec014-notice.sh). A `_rule`
# finding here would make lint-gate exit PASS-BLIND on every exec of every synced project until
# someone answers a question — the #229 pattern. The silence is not a pass: the sync names it.
# After configuring, SEC014 jumps 0 -> N in one run; re-baseline right then
# (lint-gate.sh --update-baseline --reason "SEC014 configured", then the user runs
# baseline-approve.sh lint), or the
# rise is blamed on whatever script runs next.
#
# SELF-CHECKS (configured but unusable: the rule must say so, never report a clean pass):
#   - external_roles empty, or a YAML list: `_rule` finding.
#   - a configured name matches no user role and no module role: `_rule` finding (typo, or
#     user_roles() / role_mappings() return nothing on this mxcli).
#   - persistable entities exist and permissions_for() returns no row for any of them: the
#     catalog is not FULL (permissions are only indexed by `REFRESH CATALOG FULL`).
#
# Vocabulary (mxcli 0.26.0 source, mdl/catalog/builder_permissions.go; probe on your model):
#   permissions_for(e).access_type: CREATE READ WRITE DELETE MEMBER_READ MEMBER_WRITE
#   member_name: an attribute or association name, bare or qualified; compared on its last
#   segment. entity_type: "Persistent" in Starlark (compared case-insensitively here).
#   sqlite3 .mxcli/catalog.db "SELECT AccessType, COUNT(*) FROM permissions GROUP BY 1;"
#   sqlite3 .mxcli/catalog.db "SELECT DISTINCT DataType FROM attributes;"

RULE_ID = "SEC014"
RULE_NAME = "ExternalRoleWritesControlledMembers"
DESCRIPTION = "An external user role can write all members, a state enumeration, an audit attribute or an ownership association"
CATEGORY = "security"
SEVERITY = "warning"

REQUIRES = ["full"]

SKIP_MODULES = ("System", "Administration")
DEFAULT_STATE_NAMES = "Status, State, Result, Stage, Phase"
# Audit attributes: CreatedAt, ApprovedBy, Submitted_At. Case-sensitive on purpose: "Format",
# "Nearby" and "Flat" do not match.
AUDIT_PATTERN = "[a-z0-9_](At|By)$"
OFF_VALUES = ("none", "-", "off")
UNSET = "__mxtk_unset__"


def _bare(name):
    return name.split(".")[-1]


def _split(text):
    out = []
    for part in text.replace(";", ",").split(","):
        p = part.strip()
        if p and p not in out:
            out.append(p)
    return out


def _blind(msg, suggestion):
    return violation(
        message=msg,
        location=location(module="_rule", document_type="Security", document_name="SEC014"),
        suggestion=suggestion,
    )


def _resolve(names):
    # configured name -> list of module role names (as the permission rows spell them, or bare)
    urs = user_roles()
    mapped = {}
    for rm in role_mappings():
        mapped.setdefault(rm.user_role_name, []).append(rm.module_role_name)
    module_roles = {}
    for ur in urs:
        for mr in ur.module_roles:
            module_roles[mr] = True
    for rm in role_mappings():
        module_roles[rm.module_role_name] = True

    resolved = {}
    unknown = []
    for n in names:
        roles = []
        for ur in urs:
            if ur.name == n:
                roles = list(ur.module_roles) + mapped.get(n, [])
        if not roles and n in mapped:
            roles = mapped[n]
        if not roles:
            for mr in module_roles:
                if mr == n or _bare(mr) == n:
                    roles.append(mr)
        if roles:
            resolved[n] = roles
        else:
            unknown.append(n)
    return resolved, unknown, len(urs) + len(module_roles)


def _role_matches(perm_role, roles):
    for r in roles:
        if perm_role == r:
            return True
        # one side qualified, the other bare
        if ("." in perm_role) != ("." in r) and _bare(perm_role) == _bare(r):
            return True
    return False


def check():
    raw = get_option("external_roles", UNSET)
    if raw == UNSET:
        # Not decided yet: sync-project.sh prints a NOTE on every sync (see header).
        return []
    if raw == None or type(raw) != "string":
        # lint-gate prints message[:160] only, so the fix goes in the message.
        return [_blind(
            "SEC014 blind: external_roles is a list/non-text; write one text in .claude/lint-config.yaml rules: SEC014: options: external_roles: \"A, B\"",
            "mxcli passes a YAML list to Starlark as None (got {}). Write the roles as one comma-separated text.".format(type(raw)),
        )]
    if raw.strip().lower() in OFF_VALUES:
        return []
    names = _split(raw)
    if not names:
        return [_blind(
            "SEC014 blind: external_roles empty. Ask the user; set .claude/lint-config.yaml rules: SEC014: options: external_roles (\"none\" only on their answer)",
            "\"none\" turns this security rule off: only on the user's answer in chat, recorded in PROJECT.md, never to silence this finding.",
        )]

    raw_states = get_option("state_names", DEFAULT_STATE_NAMES)
    if type(raw_states) != "string":
        raw_states = DEFAULT_STATE_NAMES
    state_names = _split(raw_states)

    resolved, unknown, role_count = _resolve(names)
    violations = []
    if unknown:
        violations.append(_blind(
            "SEC014 blind: no such role {} ({} seen); fix .claude/lint-config.yaml rules: SEC014: options: external_roles".format(
                ", ".join(["'" + u + "'" for u in unknown])[:40], role_count),
            "Check the spelling against `SHOW USER ROLES` / `SHOW MODULE ROLES`; if roles exist and none is seen, user_roles() / role_mappings() return nothing on this mxcli.",
        ))
    if not resolved:
        return violations

    persistable = 0
    perm_rows = 0
    for e in entities():
        if e.module_name in SKIP_MODULES or e.is_external:
            continue
        if e.entity_type.lower() != "persistent":
            continue
        persistable += 1
        perms = permissions_for(e.qualified_name)
        perm_rows += len(perms)
        if not perms:
            continue

        attrs = {}
        for a in attributes_for(e.qualified_name):
            attrs[a.name] = a

        for cfg_name in names:
            roles = resolved.get(cfg_name)
            if not roles:
                continue
            written = {}      # bare member -> True
            owner_assocs = {}
            for p in perms:
                if p.access_type != "MEMBER_WRITE" or not _role_matches(p.module_role_name, roles):
                    continue
                m = _bare(p.member_name)
                if not m:
                    continue
                written[m] = True
                # Not an own attribute = an association (associations() does not exist
                # before mxcli 0.25.0, and an undefined builtin makes the file not load).
                if m not in attrs and p.xpath_constraint and matches(p.xpath_constraint, "(^|[^A-Za-z0-9_])" + m + "($|[^A-Za-z0-9_])"):
                    owner_assocs[m] = True
            if not written:
                continue

            all_members = len(attrs) > 0 and len([a for a in attrs if a in written]) == len(attrs)
            states = sorted([m for m in written if m in attrs and "enum" in attrs[m].data_type.lower()
                             and len([s for s in state_names if m == s or m.endswith(s)]) > 0])
            audits = sorted([m for m in written if m in attrs and matches(m, AUDIT_PATTERN)])
            owners = sorted(owner_assocs.keys())
            if not (all_members or states or audits or owners):
                continue

            parts = []
            if all_members:
                parts.append("all {} attributes (write *)".format(len(attrs)))
            if states:
                parts.append("state " + ", ".join(states))
            if audits:
                parts.append("audit " + ", ".join(audits))
            if owners:
                parts.append("ownership association " + ", ".join(owners))
            violations.append(violation(
                message="Entity '{}': external role '{}' can write {}. The client API lets that role change these directly, past the microflow meant to own them.".format(
                    e.qualified_name, cfg_name, "; ".join(parts)),
                location=location(module=e.module_name, document_type="Entity", document_name=e.qualified_name),
                suggestion="Split the grant: read on all members, plus create and write of only the input members, gated on the initial state in the XPath (e.g. [Status = 'Draft']). Set state, audit and owner members in a microflow the role may execute.",
            ))

    if persistable > 0 and perm_rows == 0:
        violations.append(_blind(
            "SEC014 blind: {} persistable entities, no access rule rows: catalog not FULL. Run REFRESH CATALOG FULL, then lint again.".format(persistable),
            "Run `REFRESH CATALOG FULL` (permissions are only indexed in full mode), then lint again.",
        ))

    return violations
