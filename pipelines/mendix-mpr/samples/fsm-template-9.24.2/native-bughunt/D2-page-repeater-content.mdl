create module Repro;
create or modify persistent entity Repro.E ( Name: String(200) );
create or modify page Repro.P1 (Title: 'P1', Layout: Atlas_Core.Atlas_Default) {
  placeholder Main {
    repeater repeater1 (DataSource: database from Repro.E) {
      content {
        container container2 ( ) {
        }
      }
    }
  }
}
