{
  "id": "F001",
  "title": "Vessel, Agent & Port Master Data",
  "modules": [
    "HBB_MasterData"
  ],
  "actors": [
    "ShippingAgent",
    "BerthOfficer",
    "HarbourMaster"
  ],
  "useCases": [
    {
      "id": "UC001",
      "title": "Register a shipping agent",
      "actors": [
        "ShippingAgent",
        "BerthOfficer"
      ],
      "preconditions": [
        "Agency is licensed to operate at the port"
      ],
      "postconditions": [
        "A ShippingAgent record exists, IsSuspended = No, awaiting activation"
      ],
      "mainFlow": [
        "1. A shipping agent registers with a company name, port licence number and a contact e-mail address.",
        "2. A Berth Officer activates the registration."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_MasterData"
      ],
      "sourceRef": "analysis/knowledge-base/text/11-agent-onboarding.md#L20"
    },
    {
      "id": "UC002",
      "title": "Suspend an agent automatically on overdue invoices",
      "actors": [
        "ShippingAgent"
      ],
      "preconditions": [
        "Agent has 3 or more Overdue invoices"
      ],
      "postconditions": [
        "ShippingAgent.IsSuspended = Yes",
        "Agent cannot submit new booking requests",
        "Existing Approved bookings remain valid"
      ],
      "mainFlow": [
        "1. System counts the agent's Overdue invoices.",
        "2. On reaching 3, the system sets IsSuspended = Yes."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_MasterData"
      ],
      "sourceRef": "analysis/knowledge-base/text/11-agent-onboarding.md#L20"
    },
    {
      "id": "UC003",
      "title": "Reactivate a suspended agent",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [
        "Agent is suspended"
      ],
      "postconditions": [
        "ShippingAgent.IsSuspended = No"
      ],
      "mainFlow": [
        "1. Harbour Master reactivates the agent.",
        "2. There is no self-service reactivation path for the agent."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_MasterData"
      ],
      "sourceRef": "analysis/knowledge-base/text/11-agent-onboarding.md#L20"
    },
    {
      "id": "UC004",
      "title": "Maintain berth and terminal master data",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [],
      "postconditions": [
        "Berth/Terminal records reflect current physical port configuration"
      ],
      "mainFlow": [
        "1. Each berth records a code, a name, a maximum vessel length, a maximum draught, shore power availability and a status of Available, Closed or Maintenance.",
        "2. Each berth belongs to exactly one terminal."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_MasterData"
      ],
      "sourceRef": "analysis/knowledge-base/text/12-berth-master-data.md#L24"
    }
  ],
