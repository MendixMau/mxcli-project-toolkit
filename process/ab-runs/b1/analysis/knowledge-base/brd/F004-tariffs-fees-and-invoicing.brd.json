  "microflows": [
    {
      "name": "CAL_BookingRequest_BerthFee",
      "module": "HBB_Billing",
      "purpose": "Computes the berth fee for a booking: length x days-alongside x rate, VAT, shore power, surcharges.",
      "params": [
        {
          "name": "Booking",
          "type": "BookingRequest"
        }
      ],
      "returns": "Decimal",
      "pattern": "calculation",
      "calls": [],
      "validations": [
        "Days-alongside rounded up to whole days, minimum 1 day.",
        "VAT 21% added to all berth fees.",
        "Shore power flat 250/day when offered and requested.",
        "Late arrival (>2h after ETA): +15% surcharge, waivable for vessels <80m by a Berth Officer.",
        "Late cancellation (within 72h of ETA): 50% of the berth fee."
      ]
    },
    {
      "name": "ACT_Invoice_GenerateOnCompletion",
      "module": "HBB_Billing",
      "purpose": "Fires when a booking's Status changes to Completed; creates the Invoice.",
      "params": [
        {
          "name": "Booking",
          "type": "BookingRequest"
        }
      ],
      "returns": "Invoice",
      "pattern": "domain-event",
      "calls": [
        "CAL_BookingRequest_BerthFee"
      ],
      "validations": [
        "DueOn = IssuedOn + 30 days."
      ]
    },
    {
      "name": "ACT_Invoice_MarkPaidOrVoid",
      "module": "HBB_Billing",
      "purpose": "Harbour-Master-only status change.",
      "params": [
        {
          "name": "Invoice",
          "type": "Invoice"
        }
      ],
      "returns": "Void",
      "pattern": "guarded-action",
      "calls": [],
      "validations": [
        "Only callable by role HarbourMaster.",
        "A Paid invoice cannot be edited."
      ]
    },
    {
      "name": "SUB_Invoice_AgeToOverdue",
      "module": "HBB_Billing",
      "purpose": "Scheduled daily: flips Issued invoices past DueOn to Overdue.",
      "params": [],
      "returns": "Void",
      "pattern": "scheduled-event",
      "calls": [],
      "validations": []
    }
  ],
