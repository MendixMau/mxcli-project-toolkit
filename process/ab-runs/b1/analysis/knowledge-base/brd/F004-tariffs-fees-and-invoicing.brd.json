{
  "id": "F004",
  "title": "Tariffs, Fees & Invoicing",
  "modules": [
    "HBB_Billing"
  ],
  "actors": [
    "HarbourMaster",
    "BerthOfficer"
  ],
  "useCases": [
    {
      "id": "UC001",
      "title": "Maintain a terminal tariff",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [],
      "postconditions": [
        "Tariff record active for its validity period"
      ],
      "mainFlow": [
        "1. Tariffs are defined per terminal with a rate per metre of vessel length per day, a currency and a validity period."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_Billing"
      ],
      "sourceRef": "analysis/knowledge-base/text/18-tariff-structure.md#L22"
    },
    {
      "id": "UC002",
      "title": "Calculate the berth fee for a completed stay",
      "actors": [],
      "preconditions": [
        "Booking Status = Completed"
      ],
      "postconditions": [
        "Fee computed and available for invoicing"
      ],
      "mainFlow": [
        "1. Berth fee = vessel length x days-alongside x tariff rate, days rounded up to whole days, minimum 1 day.",
        "2. VAT of 21% is added to all berth fees.",
        "3. Shore power is billed at a flat 250/day when the berth offers it and the agent requested it.",
        "4. A vessel arriving more than 2 hours after its ETA incurs a late-arrival surcharge of 15% of the berth fee (waivable by a Berth Officer for vessels shorter than 80m).",
        "5. A cancellation made within 72 hours of ETA is charged 50% of the berth fee."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_Billing"
      ],
      "sourceRef": "analysis/knowledge-base/text/18-tariff-structure.md#L26"
    },
    {
      "id": "UC003",
      "title": "Generate an invoice on booking completion",
      "actors": [],
      "preconditions": [
        "Booking Status changes to Completed"
      ],
      "postconditions": [
        "Invoice created, Status = Draft or Issued, DueOn = IssuedOn + 30 days"
      ],
      "mainFlow": [
        "1. An invoice is generated automatically when a booking is marked Completed."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_Billing"
      ],
      "sourceRef": "analysis/knowledge-base/text/20-invoicing.md#L20"
    },
    {
      "id": "UC004",
      "title": "Mark an invoice Paid or Void",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [
        "Invoice.Status != Paid"
      ],
      "postconditions": [
        "Invoice.Status updated",
        "A Paid invoice can no longer be edited"
      ],
      "mainFlow": [
        "1. A Harbour Master can mark an invoice as Paid or Void; a Paid invoice cannot be edited."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_Billing"
      ],
      "sourceRef": "analysis/knowledge-base/text/20-invoicing.md#L24"
    },
    {
      "id": "UC005",
      "title": "Age an invoice to Overdue",
      "actors": [],
      "preconditions": [
        "Invoice.Status = Issued",
        "current date > DueOn"
      ],
      "postconditions": [
        "Invoice.Status = Overdue"
      ],
      "mainFlow": [
        "1. Invoices are due 30 days after the issue date and become Overdue on the day after the due date."
      ],
      "screens": [],
      "mdlRefs": [
        "HBB_Billing"
      ],
      "sourceRef": "sources/decisions-log.md (ADR-006)"
    }
  ],
