  "microflows": [
    {
      "name": "ACT_Inspection_Schedule",
      "module": "HBB_Inspection",
      "purpose": "Creates an Inspection against a booking and notifies the agent.",
      "params": [
        {
          "name": "Booking",
          "type": "BookingRequest"
        },
        {
          "name": "ScheduledFor",
          "type": "DateTime"
        }
      ],
      "returns": "Inspection",
      "pattern": "validate-then-save",
      "calls": [
        "ACT_Notification_Send"
      ],
      "validations": [
        "Booking must be Approved, or UnderReview with CargoClass = DangerousGoods."
      ]
    },
    {
      "name": "ACT_Inspection_RecordOutcome",
      "module": "HBB_Inspection",
      "purpose": "Persists checklist items and derives the inspection Outcome.",
      "params": [
        {
          "name": "Inspection",
          "type": "Inspection"
        }
      ],
      "returns": "Void",
      "pattern": "validate-then-save",
      "calls": [],
      "validations": [
        "Any non-compliant High-severity item forces Outcome = Failed."
      ]
    },
    {
      "name": "ACT_BookingRequest_GrantDepartureClearance",
      "module": "HBB_Inspection",
      "purpose": "Berth-Officer-only clearance grant.",
      "params": [
        {
          "name": "Booking",
          "type": "BookingRequest"
        }
      ],
      "returns": "Void",
      "pattern": "guarded-action",
      "calls": [],
      "validations": [
        "Every Inspection on the booking must be Passed or Deferred."
      ]
    }
  ],
  "pages": [
    {
      "name": "InspectionCalendar_Screen",
      "module": "HBB_Inspection",
      "layout": "Atlas_Default",
      "purpose": "Inspections per day/inspector, drag-and-drop reschedule.",
      "dataContext": "Inspection list",
      "sections": [
        "Calendar"
      ],
      "actions": [
        "ACT_Inspection_Schedule"
      ]
    }
  ],
