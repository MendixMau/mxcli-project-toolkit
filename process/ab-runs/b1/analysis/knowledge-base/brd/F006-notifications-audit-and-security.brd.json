        {
          "name": "Actor",
          "type": "String",
          "length": 200,
          "mandatory": true
        },
        {
          "name": "Action",
          "type": "String",
          "length": 100,
          "mandatory": true
        },
        {
          "name": "EntityName",
          "type": "String",
          "length": 60,
          "mandatory": true
        },
        {
          "name": "Detail",
          "type": "String",
          "length": 1000,
          "mandatory": false
        }
      ],
      "associations": [
        {
          "name": "AuditEntry_BookingRequest",
          "target": "BookingRequest",
          "type": "ManyToOne",
          "owner": "AuditEntry"
        }
      ]
    }
