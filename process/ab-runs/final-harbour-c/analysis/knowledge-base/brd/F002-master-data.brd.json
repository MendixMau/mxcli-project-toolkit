    {
      "id": "UC002-4",
      "title": "Automatic suspension on overdue invoices",
      "actors": [
        "ShippingAgent"
      ],
      "preconditions": [
        "ShippingAgent has 3 or more Invoice records with Status = Overdue"
      ],
      "postconditions": [
        "ShippingAgent.IsSuspended = true"
      ],
      "mainFlow": [
        "1. An agent with three or more overdue invoices is automatically suspended.",
        "2. A suspended agent cannot submit new booking requests.",
        "3. Bookings that are already Approved remain valid."
      ],
      "validations": [
        "BookingRequest submission blocked when ShippingAgent.IsSuspended = true"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/11-agent-onboarding.md#L36",
      "status": "doc-confirmed"
    },
    {
      "id": "UC002-5",
      "title": "Reactivation is Harbour Master only, no self-service",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [
        "ShippingAgent.IsSuspended = true"
      ],
      "postconditions": [
        "ShippingAgent.IsSuspended = false"
      ],
      "mainFlow": [
        "1. There is no self-service reactivation; a suspended agent is reactivated only by the Harbour Master."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/11-agent-onboarding.md#L34",
      "status": "doc-confirmed"
    },
