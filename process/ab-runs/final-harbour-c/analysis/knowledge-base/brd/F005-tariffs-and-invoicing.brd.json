          "type": "ManyToOne",
          "owner": "Invoice"
        }
      ],
      "sourceRef": "analysis/knowledge-base/text/36-appendix-data-dictionary.md#L79"
    }
  ],
  "microflows": [
    {
      "name": "ACT_Invoice_GenerateOnComplete",
      "module": "HB_Finance",
      "purpose": "Computes berth fee + VAT + shore power + surcharges, creates Invoice with DueOn=IssuedOn+30d."
    },
    {
      "name": "SCHED_Invoice_MarkOverdue",
      "module": "HB_Finance",
      "purpose": "Scheduled: flips Issued invoices past DueOn to Overdue.",
      "pattern": "scheduled"
    }
  ],
