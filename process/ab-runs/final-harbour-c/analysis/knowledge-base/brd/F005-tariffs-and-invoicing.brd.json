        {
          "name": "IssuedOn",
          "type": "Date",
          "mandatory": true
        },
        {
          "name": "DueOn",
          "type": "Date",
          "mandatory": true
        },
        {
          "name": "TotalAmount",
          "type": "Decimal",
          "mandatory": true
