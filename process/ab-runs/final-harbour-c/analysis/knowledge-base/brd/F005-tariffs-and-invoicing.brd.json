{
  "id": "F005",
  "title": "Tariffs & Invoicing",
  "modules": [
    "HB_Finance"
  ],
  "actors": [
    "HarbourMaster",
    "BerthOfficer",
    "ShippingAgent"
  ],
  "provenance": "documents",
  "useCases": [
    {
      "id": "UC005-1",
      "title": "Rate cards per terminal",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. Tariffs are defined per terminal with a rate per metre of vessel length per day, a currency and a validity period."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/18-tariff-structure.md#L30",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-2",
      "title": "Berth fee calculation",
      "actors": [],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. The berth fee is vessel length times days alongside times the tariff rate.",
        "2. Days alongside is rounded up to whole days, minimum one day."
      ],
      "validations": [
        "days = ceil(ETD-ETA in days); days >= 1"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/18-tariff-structure.md#L40",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-3",
      "title": "VAT",
      "actors": [],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. VAT of 21% is added to all berth fees."
      ],
      "validations": [
        "VAT = 21% of berth fee"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/18-tariff-structure.md#L49",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-4",
      "title": "Shore power surcharge",
      "actors": [],
      "preconditions": [
        "Berth.HasShorePower = true",
        "BookingRequest.ShorePowerRequested = true"
      ],
      "postconditions": [],
      "mainFlow": [
        "1. Shore power is billed at a flat 250 per day when the berth offers it and the agent requested it."
      ],
      "validations": [
        "shorePowerFee = 250 * days when applicable"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/18-tariff-structure.md#L75",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-5",
      "title": "Late-arrival surcharge",
      "actors": [],
      "preconditions": [
        "Actual arrival > ETA + 2h"
      ],
      "postconditions": [],
      "mainFlow": [
        "1. A vessel arriving more than 2 hours after its ETA incurs a late-arrival surcharge of 15% of the berth fee."
      ],
      "validations": [
        "lateArrivalSurcharge = 15% of berth fee when arrival > ETA+2h"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/19-tariffs-cancellation-fees.md#L32",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-6",
      "title": "Late-arrival surcharge waiver for small vessels",
      "actors": [
        "BerthOfficer"
      ],
      "preconditions": [
        "Vessel.LengthOverall < 80m"
      ],
      "postconditions": [],
      "mainFlow": [
        "1. A berth officer may waive the late-arrival surcharge for vessels shorter than 80 metres."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/24-inspection-outcomes.md#L34",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-7",
      "title": "Late-cancellation fee",
      "actors": [],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. Cancellations made within 72 hours of ETA are charged 50% of the berth fee (see F003-Q1 for the ch10/ch19 conflict this resolves)."
      ],
      "validations": [
        "cancellationFee = 50% of berth fee when cancelled within 72h of ETA"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/19-tariffs-cancellation-fees.md#L44",
      "status": "doc-conflict"
    },
    {
      "id": "UC005-8",
      "title": "Surcharge waiver restricted to Harbour Master",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. Only the Harbour Master may waive a tariff surcharge."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/13-berth-allocation-rules.md#L36",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-9",
      "title": "Invoice generated on Completed",
      "actors": [],
      "preconditions": [
        "BookingRequest.Status = Completed"
      ],
      "postconditions": [
        "Invoice created"
      ],
      "mainFlow": [
        "1. An invoice is generated automatically when a booking is marked Completed."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/20-invoicing.md#L28",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-10",
      "title": "Invoice due date and overdue transition",
      "actors": [],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. Invoices are due 30 days after the issue date.",
        "2. An invoice becomes Overdue on the day after the due date."
      ],
      "validations": [
        "DueOn = IssuedOn + 30 days",
        "Status -> Overdue when today > DueOn and not Paid/Void"
      ],
      "screens": [],
      "sourceRef": "sources/decisions-log.md#L49",
      "status": "doc-confirmed"
    },
    {
      "id": "UC005-11",
      "title": "Mark invoice Paid or Void \u2014 Harbour Master only",
      "actors": [
        "HarbourMaster"
      ],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. A Harbour Master can mark an invoice as Paid or Void; a Paid invoice cannot be edited."
      ],
      "validations": [
        "Paid invoice is read-only"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/20-invoicing.md#L39",
      "status": "doc-confirmed"
    }
  ],
  "domainEntities": [
