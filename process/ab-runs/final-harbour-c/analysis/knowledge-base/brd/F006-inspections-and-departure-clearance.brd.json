{
  "id": "F006",
  "title": "Inspections & Departure Clearance",
  "modules": [
    "HB_Inspection"
  ],
  "actors": [
    "Inspector",
    "BerthOfficer",
    "ShippingAgent"
  ],
  "provenance": "documents",
  "useCases": [
    {
      "id": "UC006-1",
      "title": "Schedule inspection against an Approved booking",
      "actors": [
        "Inspector"
      ],
      "preconditions": [
        "BookingRequest.Status = Approved"
      ],
      "postconditions": [
        "Inspection created, Status = Pending; agent notified"
      ],
      "mainFlow": [
        "1. An inspector schedules an inspection against an Approved booking and the agent is notified of the time slot."
      ],
      "screens": [
        "Inspection Calendar"
      ],
      "sourceRef": "analysis/knowledge-base/text/22-inspection-scheduling.md#L28",
      "status": "doc-confirmed"
    },
    {
      "id": "UC006-2",
      "title": "Dangerous-goods bookings require an inspection before approval",
      "actors": [
        "BerthOfficer"
      ],
      "preconditions": [
        "BookingRequest.CargoClass = DangerousGoods"
      ],
      "postconditions": [],
      "mainFlow": [
        "1. A booking with cargo class Dangerous Goods cannot be Approved until an inspection has been scheduled."
      ],
      "validations": [
        "CargoClass=DangerousGoods requires an Inspection to exist before Status can become Approved"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/22-inspection-scheduling.md#L36",
      "status": "doc-confirmed"
    },
    {
      "id": "UC006-3",
      "title": "Checklist categories",
      "actors": [
        "Inspector"
      ],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. An inspection consists of checklist items in the categories Safety, Environmental, Documentation and Security."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/23-inspection-checklist.md#L33",
      "status": "doc-confirmed"
    },
    {
      "id": "UC006-4",
      "title": "Recording a checklist item",
      "actors": [
        "Inspector"
      ],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. For each checklist item the inspector records compliant or not compliant, a severity of Low, Medium or High, and an optional note."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/23-inspection-checklist.md#L43",
      "status": "doc-confirmed"
    },
    {
      "id": "UC006-5",
      "title": "Inspection outcome \u2014 Failed on High-severity non-compliance",
      "actors": [
        "Inspector"
      ],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. An inspection whose checklist contains any non-compliant item of High severity has the outcome Failed."
      ],
      "validations": [
        "Outcome=Failed when any InspectionItem.IsCompliant=false AND Severity=High"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/23-inspection-checklist.md#L55",
      "status": "doc-confirmed"
    },
    {
      "id": "UC006-6",
      "title": "Failed inspection blocks departure until follow-up passes",
      "actors": [
        "Inspector",
        "BerthOfficer"
      ],
      "preconditions": [
        "Inspection.Outcome = Failed"
      ],
      "postconditions": [],
      "mainFlow": [
        "1. A Failed inspection blocks departure clearance until a follow-up inspection has Passed."
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/24-inspection-outcomes.md#L28",
      "status": "doc-confirmed"
    },
    {
      "id": "UC006-7",
      "title": "Departure clearance",
      "actors": [
        "BerthOfficer"
      ],
      "preconditions": [
        "Every Inspection on the booking is Passed or Deferred"
      ],
      "postconditions": [
        "Departure clearance granted"
      ],
      "mainFlow": [
        "1. Departure clearance is granted by a Berth Officer and requires every inspection on the booking to be Passed or Deferred."
      ],
      "validations": [
        "all Inspection.Outcome in (Passed, Deferred) before clearance"
      ],
      "screens": [],
      "sourceRef": "analysis/knowledge-base/text/25-departure-clearance.md#L27",
      "status": "doc-confirmed"
    },
    {
      "id": "UC006-8",
      "title": "Inspection Calendar \u2014 per day/inspector, drag-drop reschedule",
      "actors": [
        "Inspector"
      ],
      "preconditions": [],
      "postconditions": [],
      "mainFlow": [
        "1. The Inspection Calendar shows inspections per day and per inspector and allows drag-and-drop rescheduling."
      ],
      "screens": [
        "Inspection Calendar"
      ],
      "sourceRef": "analysis/knowledge-base/text/31-inspection-calendar-screen.md#L27",
      "status": "doc-confirmed"
    }
  ],
  "domainEntities": [
    {
      "name": "Inspection",
      "module": "HB_Inspection",
      "persistent": true,
      "attributes": [
        {
          "name": "ScheduledFor",
          "type": "DateTime",
          "mandatory": true
        },
        {
          "name": "CompletedOn",
          "type": "DateTime",
          "mandatory": false
        },
        {
          "name": "Outcome",
          "type": "Enumeration",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Deferred"
          ],
          "mandatory": true
        },
        {
          "name": "InspectorName",
          "type": "String",
          "length": 100,
          "mandatory": true
        },
        {
          "name": "Findings",
          "type": "String",
          "length": 1000,
          "mandatory": false
        },
        {
          "name": "FollowUpRequired",
          "type": "Boolean",
          "mandatory": true
        }
      ],
      "associations": [
        {
          "name": "Inspection_BookingRequest",
          "target": "BookingRequest",
          "type": "ManyToOne",
          "owner": "Inspection"
        }
      ],
      "sourceRef": "analysis/knowledge-base/text/36-appendix-data-dictionary.md#L94"
    },
    {
      "name": "InspectionItem",
      "module": "HB_Inspection",
      "persistent": true,
      "attributes": [
        {
          "name": "Category",
          "type": "Enumeration",
          "enum": [
            "Safety",
            "Environmental",
            "Documentation",
            "Security"
          ],
          "mandatory": true
        },
        {
          "name": "Description",
          "type": "String",
          "length": 300,
          "mandatory": true
        },
        {
          "name": "IsCompliant",
          "type": "Boolean",
          "mandatory": true
        },
        {
          "name": "Severity",
          "type": "Enumeration",
          "enum": [
            "Low",
            "Medium",
            "High"
          ],
          "mandatory": false
        },
        {
          "name": "Note",
          "type": "String",
          "length": 300,
          "mandatory": false
        }
      ],
      "associations": [
        {
          "name": "InspectionItem_Inspection",
          "target": "Inspection",
          "type": "ManyToOne",
          "owner": "InspectionItem"
        }
      ],
      "sourceRef": "analysis/knowledge-base/text/36-appendix-data-dictionary.md#L109"
    }
  ],
  "microflows": [
    {
      "name": "ACT_Inspection_Complete",
      "module": "HB_Inspection",
      "purpose": "Sets Outcome=Failed when any High-severity item is non-compliant; else Passed/Deferred per inspector input."
    },
    {
      "name": "VAL_DepartureClearance_Check",
      "module": "HB_Inspection",
      "purpose": "Blocks clearance unless every Inspection on the booking is Passed or Deferred."
    }
  ],
  "pages": [
    {
      "name": "InspectionCalendar_Overview",
      "module": "HB_Inspection",
      "purpose": "Per-day/per-inspector calendar, drag-drop reschedule"
    },
    {
      "name": "Inspection_Checklist",
      "module": "HB_Inspection",
      "purpose": "Record checklist items + outcome"
    }
  ],
  "integrations": [],
  "openQuestions": [],
  "sourceKB": [
    "22-inspection-scheduling.html",
    "23-inspection-checklist.html",
    "24-inspection-outcomes.html",
    "25-departure-clearance.html",
    "31-inspection-calendar-screen.html",
    "36-appendix-data-dictionary.html"
  ]
}
