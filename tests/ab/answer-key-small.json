{
 "app": "Harbour Berth Booking",
 "version": "1-small",
 "description": "Synthetic ground truth for an A/B experiment on the mxcli-project-toolkit Stage 0-2 pipeline. A fictional port authority lets shipping agents book berths; berth officers approve; tariffs are invoiced; inspectors run checklists. Nothing here refers to a real organisation, product or person. [small variant: sidecar images trimmed to 1-2/page and inline screenshots to 2, so an unattended run finishes inside session limits; every requirement, rule, contradiction and screenshot-only item is unchanged from the full key.]",
 "roles": [
  {
   "name": "ShippingAgent",
   "label": "Shipping Agent",
   "description": "Employee of a licensed shipping agency; creates and manages booking requests for the vessels the agency represents."
  },
  {
   "name": "BerthOfficer",
   "label": "Berth Officer",
   "description": "Port authority officer who reviews booking requests, records decisions and grants departure clearance."
  },
  {
   "name": "HarbourMaster",
   "label": "Harbour Master",
   "description": "Senior officer; everything a Berth Officer can do plus overrides, agent reactivation and tariff maintenance."
  },
  {
   "name": "Inspector",
   "label": "Inspector",
   "description": "Schedules and performs inspections and records checklist outcomes."
  }
 ],
 "screens": [
  {
   "name": "BookingBoard",
   "label": "Booking Board",
   "role": "BerthOfficer"
  },
  {
   "name": "MyBookings",
   "label": "My Bookings",
   "role": "ShippingAgent"
  },
  {
   "name": "InspectionCalendar",
   "label": "Inspection Calendar",
   "role": "Inspector"
  }
 ],
