/**
 * Catalog item (supplier BRD E2).
 */
@Position(1140, 100)
create or modify persistent entity Procurement.CatalogItem (
  Sku: String(40) unique,
  Name: String(160),
  Description: String(500),
  Category: String(60),
  UnitPrice: Decimal,
  Active: Boolean default true
);

grant Procurement.Admin, Procurement.ProcurementOfficer on Procurement.CatalogItem (create, delete, read *, write *);

grant Procurement.Employee, Procurement.DepartmentManager, Procurement.FinanceApprover on Procurement.CatalogItem (read *);

grant Procurement.APClerk, Procurement.TreasuryOfficer, Procurement.CFO, Procurement.APManager, Procurement.Warehouse on Procurement.CatalogItem (read *);
/
