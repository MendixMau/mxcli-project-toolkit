/**
 * Page button: approve the current step with the comment typed on it.
 */
create or modify microflow Sales.ACT_ApprovalStep_Approve (
  $ApprovalStep: Sales.ApprovalStep
)
folder 'SalesOrder/Microflows'
begin
  @position(360, 200)
  retrieve $Req from $ApprovalStep/Sales.ApprovalStep_SalesOrder;
  @position(520, 200)
  $Res = call microflow Sales.ACT_ApprovalStep_Decide(SalesOrder = $Req, Approve = true, Comments = $ApprovalStep/Comments);
  @position(680, 200)
  @merge(1130, 200)
  @caption '$Res != empty'
  if $Res != empty then
    @position(850, 300)
    close page;
    @position(1010, 300)
    show page Sales.SalesOrderLine($SalesOrder = $Req);
  end if;
  @position(1330, 200)
  return;
end;

grant execute on microflow Sales.ACT_ApprovalStep_Approve to Sales.Admin, Sales.DepartmentManager, Sales.SalesOfficer, Sales.FinanceApprover;
/
