create or modify page Procurement.CatalogItem_Overview (
  Title: 'Catalog',
  Layout: Atlas_Core.Atlas_Default,
  Url: 'catalog',
  Folder: 'Supplier/Pages'
) {
  container colMain (Class: 'page-column') {
    container hdr (Class: 'page-header') {
      container hdrText (Class: 'page-header-text') {
        dynamictext "title" (Content: 'Catalog', RenderMode: H1, Class: 'page-title')
        dynamictext sub (Content: 'Orderable items with their list price and vendor.', Class: 'page-sub')
      }
      container hdrActions (Class: 'page-actions') {
        actionbutton btnNew (
          Caption: 'New item',
          Action: create_object Procurement.CatalogItem then show_page Procurement.CatalogItem_NewEdit,
          ButtonStyle: Primary
        )
      }
    }
    datagrid dgMain (DataSource: database from Procurement.CatalogItem sort by Sku asc) {
      -- Context: $currentObject (Procurement.CatalogItem), $dgMain (selection)
      column Sku (Attribute: Sku, Caption: 'SKU') {
        textfilter fSku
      }
      column Name (Attribute: Name, Caption: 'Name') {
        textfilter fName
      }
      column Category (Attribute: Category, Caption: 'Category') {
        textfilter fCategory
      }
      column UnitPrice (Attribute: UnitPrice, Caption: 'Unit price')
      column "CatalogItem_Vendor/Name" (Attribute: CatalogItem_Vendor/Name, Caption: 'Vendor') {
        textfilter fVendor
      }
      column Active (Attribute: Active, Caption: 'Active')
      column col7 (Caption: ' ', ShowContentAs: customContent) {
        actionbutton btnEdit (
          Caption: 'Edit',
          Action: show_page Procurement.CatalogItem_NewEdit(CatalogItem: $currentObject)
        )
        actionbutton btnDeactivate (
          Caption: 'Deactivate',
          Action: microflow Procurement.ACT_CatalogItem_Deactivate(CatalogItem: $currentObject),
          Visible: [$currentObject/Active]
        )
        actionbutton btnDelete (
          Caption: 'Delete',
          Action: microflow Procurement.ACT_CatalogItem_Delete(CatalogItem: $currentObject),
          ButtonStyle: Danger
        )
      }
    }
  }
}

grant view on page Procurement.CatalogItem_Overview to Procurement.Admin, Procurement.Employee, Procurement.DepartmentManager, Procurement.ProcurementOfficer, Procurement.FinanceApprover, Procurement.APClerk, Procurement.TreasuryOfficer, Procurement.CFO, Procurement.APManager, Procurement.Warehouse;
