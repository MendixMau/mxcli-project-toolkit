create or modify page Sales.Product_NewEdit (
  Title: 'Catalog item',
  Layout: Atlas_Core.PopupLayout,
  Folder: 'Catalog/Pages',
  Params: { $Product: Sales.Product }
) {
  layoutgrid g {
    row row1 {
      column col1 (DesktopWidth: AutoFill) {
        dataview dv (DataSource: $Product, ReadOnlyStyle: Control) {
          -- Context: $currentObject (Product)
          container formGrid (Class: 'form-grid') {
            container fgSku (Class: 'form-group') {
              textbox tbSku (Label: 'SKU *', Attribute: Sku)
              dynamictext helpSku (
                Content: 'Set when the item is created. It cannot change afterwards.',
                Class: 'form-help'
              )
            }
            container fgName (Class: 'form-group') {
              textbox tbName (Label: 'Name *', Attribute: Name)
            }
            container fgDescription (Class: 'form-group span-2') {
              textarea taDescription (Label: 'Description', Attribute: Description)
            }
            container fgCategory (Class: 'form-group') {
              textbox tbCategory (Label: 'Category', Attribute: Category)
            }
            container fgPrice (Class: 'form-group') {
              textbox tbPrice (Label: 'Unit price *', Attribute: UnitPrice)
            }
            container fgBrand (Class: 'form-group') {
              combobox cbBrand (
                Label: 'Brand *',
                Attribute: Product_Brand,
                DataSource: database from Sales.Brand,
                CaptionAttribute: Name
              )
            }
            container fgActive (Class: 'form-group') {
              checkbox cbActive (Label: 'Active', Attribute: Active)
              dynamictext helpActive (
                Content: 'Inactive items are not offered on new sales orders.',
                Class: 'form-help'
              )
            }
          }
          footer footer1 {
            actionbutton btnCancel (Caption: 'Cancel', Action: cancel_changes close_page, Class: 'btn')
            actionbutton btnSave (
              Caption: 'Save',
              Action: microflow Sales.ACT_Product_Save(Product: $Product),
              ButtonStyle: Primary,
              Class: 'btn btn-primary'
            )
          }
        }
      }
    }
  }
}

grant view on page Sales.Product_NewEdit to Sales.Admin, Sales.SalesOfficer;
