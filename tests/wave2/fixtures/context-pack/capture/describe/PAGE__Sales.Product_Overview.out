create or modify page Sales.Product_Overview (
  Title: 'Catalog',
  Layout: Atlas_Core.Atlas_Default,
  Url: 'catalog',
  Folder: 'Catalog/Pages'
) {
  container colMain (Class: 'page-column') {
    container hdr (Class: 'page-header') {
      container hdrText (Class: 'page-header-text') {
        dynamictext "title" (Content: 'Catalog', RenderMode: H1, Class: 'page-title')
        dynamictext sub (Content: 'Orderable items with their list price and brand.', Class: 'page-sub')
      }
      container hdrActions (Class: 'page-actions') {
        actionbutton btnNew (
          Caption: 'New item',
          Action: create_object Sales.Product then show_page Sales.Product_NewEdit,
          ButtonStyle: Primary
        )
      }
    }
    datagrid dgMain (DataSource: database from Sales.Product sort by Sku asc) {
      -- Context: $currentObject (Sales.Product), $dgMain (selection)
      column Sku (Attribute: Sku, Caption: 'SKU') {
        textfilter fSku
      }
      column Name (Attribute: Name, Caption: 'Name') {
        textfilter fName
      }
      column Category (Attribute: Category, Caption: 'Category') {
        textfilter fCategory
      }
      column UnitPrice (Attribute: UnitPrice, Caption: 'Unit price')
      column "Product_Brand/Name" (Attribute: Product_Brand/Name, Caption: 'Brand') {
        textfilter fBrand
      }
      column Active (Attribute: Active, Caption: 'Active')
      column col7 (Caption: ' ', ShowContentAs: customContent) {
        actionbutton btnEdit (
          Caption: 'Edit',
          Action: show_page Sales.Product_NewEdit(Product: $currentObject)
        )
        actionbutton btnDeactivate (
          Caption: 'Deactivate',
          Action: microflow Sales.ACT_Product_Deactivate(Product: $currentObject),
          Visible: [$currentObject/Active]
        )
        actionbutton btnDelete (
          Caption: 'Delete',
          Action: microflow Sales.ACT_Product_Delete(Product: $currentObject),
          ButtonStyle: Danger
        )
      }
    }
  }
}

grant view on page Sales.Product_Overview to Sales.Admin, Sales.Employee, Sales.DepartmentManager, Sales.SalesOfficer, Sales.FinanceApprover, Sales.APClerk, Sales.TreasuryOfficer, Sales.CFO, Sales.APManager, Sales.Warehouse;
