-- evidence: has an invalid value '' for property Attribute. The text '   ' is not a valid AttributeIdentifier.
create or modify page Module."PageName" (Title: 'Orders', Layout: Atlas_Core.Atlas_Default) {
  datagrid dgName (DataSource: database from Module.Entity) {
    column colCustom (
      Caption: 'Label',
      ShowContentAs: customContent,
      Sortable: false
    ) {
      container ctn (visible: [State = Module.ENUM_State.Open]) {
        dynamictext txtOpen (Content: 'Open')
      }
    }
  }
}
