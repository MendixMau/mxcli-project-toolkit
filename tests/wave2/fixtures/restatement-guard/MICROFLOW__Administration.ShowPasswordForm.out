mdl 1;
create or modify microflow Administration.ShowPasswordForm (
  @position(100, 0)
  $Account: Administration.Account
)
folder 'User Management/Admin'
begin
  @start(100, 200)
  @position(265, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $AccountPasswordData = create Administration.AccountPasswordData (AccountPasswordData_Account = $Account);
  @position(515, 200)
  @curve(from: (30, 0), to: (-15, 0))
  show page Administration.ChangePasswordForm(AccountPasswordData = $AccountPasswordData);
  @position(695, 200)
  return;
end;

grant execute on microflow Administration.ShowPasswordForm to Administration.Administrator;
