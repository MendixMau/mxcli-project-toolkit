mdl 1;
create or modify page Administration.ChangePasswordForm folder 'User Management/Admin' (
  Title: 'Change Password',
  Layout: Atlas_Core.PopupLayout,
  PopupResizable: true,
  PopupCloseAction: cancelButton1,
  Params: ( $AccountPasswordData: Administration.AccountPasswordData )
) {
  layoutgrid layoutGrid1 {
    row {
      column (DesktopWidth: AutoFill) {
        dataview dataView2 (DataSource: $AccountPasswordData, ReadOnlyStyle: Text) {
          -- Context: $currentObject (AccountPasswordData)
          textbox textBox3 (
            Label: 'New password',
            Attribute: NewPassword,
            Password: true,
            Validation: 'length(toString($value)) > 0',
            ValidationMessage: 'The password cannot be empty.'
          )
          textbox textBox1 (
            Label: 'Confirm password',
            Attribute: ConfirmPassword,
            Password: true,
            Validation: 'length(toString($value)) > 0',
            ValidationMessage: 'The password cannot be empty.'
          )
          footer {
            actionbutton microflowButton1 (
              Caption: 'Change',
              Action: call microflow Administration.ChangePassword with (DisabledDuringExecution: false),
              ButtonStyle: Success
            )
            actionbutton cancelButton1 (Caption: 'Cancel', Action: cancel changes close page)
          }
        }
      }
    }
  }
};
