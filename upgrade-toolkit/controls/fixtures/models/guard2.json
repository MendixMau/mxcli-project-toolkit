                                                                {"caption": "Sign out", "signout": true}]}]},
      {"name": "Phone_Menu", "items": [{"caption": "Scan", "page": "Shop.Search_Home"}]}],
    "pages": [
      {"name": "Login", "layout": "Shop.Layout_Plain", "named": [["TextBox", "usernameInput"], ["TextBox", "passwordInput"], ["ActionButton", "loginButton"]]},
      {"name": "Dashboard", "layout": "Shop.Layout_Menu", "allowed": ["Shop.Desk", "Shop.Planner"],
