                           {"name": "tabPage2", "text": "Forms", "children": [["DataView", "dataView2"]]}]}]},
      {"name": "Offline_Default", "layout": "Shop.Layout_Menu", "allowed": ["Shop.Planner"],
       "named": [{"type": "TabControl", "name": "tabControl1", "default": 1,
                  "tabs": [{"name": "tabPage1", "text": "Actions", "children": [{"type": "Label", "name": "label5", "text": "Pending actions"}]},
                           {"name": "tabPage2", "text": "Forms", "children": [["DataView", "dataView2"]]}]}]},
      {"name": "Hidden", "layout": "Shop.Layout_Menu", "allowed": ["Shop.Planner"],
       "named": [{"type": "DataView", "name": "dataView3", "hide_on": ["Desktop"]}, {"type": "Label", "name": "label6", "text": "Mobile only below"}]},
      {"name": "Shown", "layout": "Shop.Layout_Menu", "allowed": ["Shop.Planner"],
