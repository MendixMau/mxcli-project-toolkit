{
 "modules": [
  {
   "name": "Shop",
   "entities": [
    {
     "name": "Order",
     "persistent": true,
     "attributes": [
      {
       "name": "Qty",
       "type": "Integer"
      },
      {
       "name": "Note",
       "type": "String"
      }
     ],
     "access": [
      {
       "roles": [
        "Shop.Clerk"
       ],
       "create": true,
       "delete": false,
       "default": "ReadOnly"
      }
     ]
    }
   ],
   "pages": [
    {
     "name": "Home",
     "allowed": [
      "Shop.Clerk",
      "Shop.Manager"
     ]
    },
    {
     "name": "Admin",
     "allowed": [
      "Shop.Manager"
     ]
    }
   ],
   "docs": [
    {
     "type": "Microflows$Microflow",
     "name": "ACT_Save",
     "data": {
      "AllowedModuleRoles": [
       3,
       "Shop.Clerk"
      ]
     }
    },
    {
     "type": "Microflows$Microflow",
     "name": "ACT_Old",
     "excluded": true,
     "data": {
      "AllowedModuleRoles": [
       3,
       "Shop.Clerk",
       "Shop.Manager"
      ]
     }
    }
   ],
   "constants": [
    {
     "name": "Enabled",
     "type": "Boolean",
     "default": "true"
    }
   ]
  }
 ],
 "security": {
  "user_roles": {
   "Clerk": [
    "Shop.Clerk"
   ],
   "Manager": [
    "Shop.Manager"
   ]
  },
  "admin": "Manager"
 }
}
