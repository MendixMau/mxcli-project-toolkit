CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC."mendixsystem$entityidentifier"("id" VARCHAR(36) NOT NULL PRIMARY KEY,"short_id" INTEGER,"object_sequence" BIGINT)
CREATE MEMORY TABLE PUBLIC."mendixsystem$entity"("id" VARCHAR(36) NOT NULL PRIMARY KEY,"entity_name" VARCHAR(200),"table_name" VARCHAR(200),"superentity_id" VARCHAR(36))
CREATE MEMORY TABLE PUBLIC."system$user"("id" BIGINT NOT NULL PRIMARY KEY,"name" VARCHAR(200),"password" VARCHAR(200),"lastlogin" TIMESTAMP,"active" BOOLEAN)
CREATE MEMORY TABLE PUBLIC."administration$account"("id" BIGINT NOT NULL PRIMARY KEY,"fullname" VARCHAR(200))
CREATE MEMORY TABLE PUBLIC."system$userrole"("id" BIGINT NOT NULL PRIMARY KEY,"name" VARCHAR(200))
CREATE MEMORY TABLE PUBLIC."system$userroles"("system$userid" BIGINT NOT NULL,"system$userroleid" BIGINT NOT NULL,PRIMARY KEY("system$userid","system$userroleid"))
CREATE MEMORY TABLE PUBLIC."system$session"("id" BIGINT NOT NULL PRIMARY KEY,"sessionid" VARCHAR(36))
CREATE MEMORY TABLE PUBLIC."demo$product"("id" BIGINT NOT NULL PRIMARY KEY,"name" VARCHAR(100),"price" DECIMAL(28,8),"stock" INTEGER,"createddate" TIMESTAMP,"system$owner" BIGINT)
CREATE MEMORY TABLE PUBLIC."demo$order"("id" BIGINT NOT NULL PRIMARY KEY,"orderno" INTEGER,"note" VARCHAR(200),"demo$order_customer" BIGINT)
CREATE MEMORY TABLE PUBLIC."demo$order_product"("demo$orderid" BIGINT NOT NULL,"demo$productid" BIGINT NOT NULL,PRIMARY KEY("demo$orderid","demo$productid"))
CREATE INDEX "idx_order_customer" ON PUBLIC."demo$order"("demo$order_customer")
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
