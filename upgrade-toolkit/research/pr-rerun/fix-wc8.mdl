alter page PurchaseApprovals.Task_Approver {
  replace dataView2 with {
    dataview dataView2 (
      DataSource: microflow PurchaseApprovals.DS_GetWorkflow_FromUserTask,
      ReadOnlyStyle: Control
    ) {
      snippetcall snippetCall3 (Snippet: PurchaseApprovals.Comments_TaskInbox)
    }
  };
};
