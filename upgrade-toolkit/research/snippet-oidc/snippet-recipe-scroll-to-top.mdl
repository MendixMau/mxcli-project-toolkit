mdl 1;
create module UiHelpers;
create javascript action UiHelpers.JS_ScrollContentToTop() returns boolean platform web as $$
document.querySelectorAll(".mx-scrollcontainer-wrapper").forEach(function (w) { w.scrollTo({ top: 0, behavior: "smooth" }); });
return Promise.resolve(true);
$$;
create nanoflow UiHelpers.NF_ScrollContentToTop () returns boolean as $r begin
  $r = call javascript action UiHelpers.JS_ScrollContentToTop();
  return $r;
end;

alter page Showcase_AI_RESTSQLAPI.Wizard_AI_Step6_CortexAnalystAndAgent_ConversationalUI { replace hTMLSnippet7 with { events scrollOnLoad (onComponentLoad: call nanoflow UiHelpers.NF_ScrollContentToTop, componentLoadDelay: 100) } };
alter page Showcase_AI_RESTSQLAPI.Wizard_AI_Step1_Introduction { replace hTMLSnippet7 with { events scrollOnLoad (onComponentLoad: call nanoflow UiHelpers.NF_ScrollContentToTop, componentLoadDelay: 100) } };
